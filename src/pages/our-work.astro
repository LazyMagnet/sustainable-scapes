---
import Layout from '../layouts/Layout.astro';
import StrataDivider from '../components/StrataDivider.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE, PHOTOS } from '../lib/site';
import { bp } from '../lib/url';

const title = 'Our Work | Landscaping Projects Gisborne | Sustainable Scapes';
const description = 'A gallery of Sustainable Scapes landscaping projects around Gisborne, from site clearing and paving to planting, timber features and finished outdoor spaces.';
const canonical = `${SITE.domain}/our-work`;
---

<Layout title={title} description={description} canonical={canonical} keywords="landscaping projects gisborne, landscaping portfolio gisborne">
  <section class="relative overflow-hidden bg-ss-ink">
    <div class="absolute inset-0 opacity-30" style="background: radial-gradient(60% 80% at 50% 0%, #006837 0%, transparent 60%);"></div>
    <div class="relative max-w-4xl mx-auto px-4 py-16 md:py-24 text-center">
      <p class="eyebrow mb-4 text-ss-ochre">Our work</p>
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-[1.05] mb-5">Outdoor spaces we have transformed</h1>
      <p class="text-lg text-white/85 max-w-2xl mx-auto">A look at recent Sustainable Scapes projects across Gisborne, from raw site work to finished, planted gardens.</p>
    </div>
  </section>

  <StrataDivider fillFrom="#1C2A16" fillTo="#FFFFFF" line={true} />

  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12 space-y-4">
        <p class="text-lg text-slate-700 leading-relaxed">Every project here started the same way: a Gisborne property owner wanting their outdoor space sorted properly. Some were bare sections cleared and prepared from scratch, others were tired gardens brought back to life, and others were full design-and-build landscapes taken from concept to finished space.</p>
        <p class="text-lg text-slate-700 leading-relaxed">What they have in common is the approach: built for the site, planted for the conditions, and finished to a standard that still looks good seasons later. Have a look, and picture what we could do with yours.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {PHOTOS.gallery.map((src, i) => (
          <div class="aspect-square overflow-hidden rounded-2xl bg-stone-100 shadow-sm">
            <img src={src} alt={`Sustainable Scapes landscaping project in Gisborne ${i + 1}`} class="w-full h-full object-cover hover:scale-105 transition-transform" loading="lazy" />
          </div>
        ))}
      </div>
      <p class="text-center text-slate-600 mt-10 max-w-2xl mx-auto">Like what you see? Every project starts with a conversation about your space. <a href={bp('/contact')} class="text-ss-forest font-bold hover:text-ss-forest-dark">Request a quote</a> and we will take it from there.</p>
    </div>
  </section>

  <FinalCTA />
</Layout>
