---
import Layout from '../layouts/Layout.astro';
import StrataDivider from '../components/StrataDivider.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SERVICES } from '../lib/services-data';
import { SITE } from '../lib/site';
import { bp } from '../lib/url';

const title = 'Landscaping Services Gisborne | Sustainable Scapes';
const description = 'The full range of landscaping and site services in Gisborne: astroturf, paving, design and build, planting, maintenance, dingo works, site clearing and more.';
const canonical = `${SITE.domain}/services`;
const services = Object.values(SERVICES);

const schemaJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: canonical },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} keywords="landscaping services gisborne, landscaper gisborne" primaryKeyword="landscaping services" schemaJson={schemaJson}>
  <section class="relative overflow-hidden bg-ss-ink">
    <div class="absolute inset-0 opacity-30" style="background: radial-gradient(60% 80% at 25% 0%, #006837 0%, transparent 60%), radial-gradient(50% 70% at 100% 100%, #C2702C 0%, transparent 55%);"></div>
    <div class="relative max-w-4xl mx-auto px-4 py-16 md:py-24 text-center">
      <p class="eyebrow mb-4 text-ss-ochre">What we do</p>
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-[1.05] mb-5">Landscaping services across Gisborne</h1>
      <p class="text-lg text-white/85 max-w-2xl mx-auto">End-to-end landscaping and site solutions, from the first stage of site work through to the planting and finishing details. One team, accountable for the whole result.</p>
    </div>
  </section>

  <StrataDivider fillFrom="#1C2A16" fillTo="#FFFFFF" line={true} />

  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12 space-y-4">
        <p class="text-lg text-slate-700 leading-relaxed">Most outdoor projects involve more than one trade, and that is where things usually go wrong: gaps between jobs, delays, and nobody owning the final result. Sustainable Scapes is set up to handle the lot. From the first stage of clearing and groundwork through to paving, planting, irrigation and the finishing touches, it is one team and one point of accountability.</p>
        <p class="text-lg text-slate-700 leading-relaxed">Everything we do is built for Gisborne conditions and made to need less looking after, not more. Browse the services below, or if you are not sure where your project fits, just get in touch and we will point you in the right direction.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((s) => (
          <a href={bp(`/${s.slug}`)} class="group bg-white border border-stone-200 rounded-2xl overflow-hidden hover:border-ss-forest hover:shadow-xl transition-all flex flex-col">
            <div class="aspect-video overflow-hidden bg-stone-100"><img src={s.heroImage} alt={`${s.label} in Gisborne`} class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" /></div>
            <div class="p-6 flex flex-col flex-1">
              <h2 class="text-xl mb-2 group-hover:text-ss-forest transition-colors leading-snug">{s.label}</h2>
              <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1">{s.intro.split('. ')[0]}.</p>
              <span class="text-ss-forest font-bold text-sm">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA heading="Not sure which service you need?" body="Tell us about your project and we will point you to the right starting point. If you are not sure, just ask." />
</Layout>
