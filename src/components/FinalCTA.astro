---
import { SITE } from '../lib/site';
import { bp } from '../lib/url';
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Let's work together",
  body = 'Planning a new landscape, prepping a site, or improving the space you have? Tell us about your project and we will take it from there.',
} = Astro.props;
---
<section class="bg-ss-forest text-white py-16 md:py-20">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl mb-5 text-white">{heading}</h2>
    <p class="text-lg mb-8 text-white/90 max-w-2xl mx-auto leading-relaxed">{body}</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href={bp('/contact')} class="inline-flex items-center justify-center px-8 py-4 bg-white text-ss-forest font-bold rounded-lg hover:bg-ss-stone transition shadow-lg">
        Request a quote
      </a>
      <a href={`tel:${SITE.phoneTel}`} class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-bold rounded-lg border-2 border-white/60 hover:bg-white hover:text-ss-forest transition">
        Call {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</section>
