---
import { SITE } from '../lib/site';
---
<section class="bg-ss-stone py-16">
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-2">Locally based</p>
      <h2 class="text-3xl mb-5">Gisborne born and based</h2>
      <p class="text-slate-700 mb-4 leading-relaxed">Sustainable Scapes works across Gisborne and the surrounding region, on everything from residential gardens to commercial grounds and development site work.</p>
      <p class="text-slate-700 font-bold mb-1">{SITE.name}</p>
      <p class="text-slate-700">{SITE.areaServed}</p>
      <p class="mt-4">
        <a href={`tel:${SITE.phoneTel}`} class="text-ss-forest hover:text-ss-forest-dark font-bold text-xl">{SITE.phoneDisplay}</a>
      </p>
      <p><a href={`mailto:${SITE.email}`} class="text-ss-forest hover:text-ss-forest-dark">{SITE.email}</a></p>
    </div>
    <div class="aspect-video rounded-2xl overflow-hidden border border-stone-200 shadow-md">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12345!2d178.0176!3d-38.6627!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sGisborne!5e0!3m2!1sen!2snz!4v1700000000000"
        width="100%" height="100%" style="border:0" loading="lazy"
        referrerpolicy="no-referrer-when-downgrade" title="Sustainable Scapes service area, Gisborne"
      ></iframe>
    </div>
  </div>
</section>
